Project SCOLOCK {
  database_type: 'MySQL'
  Note: 'SCO/LOCK 1차 MVP'
}


// ======================================
// Enum
// ======================================

Enum ExtractionStatus {
  PENDING
  COMPLETED
  FAILED
}

Enum AiRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum CriteriaVersionStatus {
  DRAFT
  CONFIRMED
}

Enum RequestAnalysisClassification {
  MISSING_INFO
  AMBIGUOUS
  BASELINE_CHANGE
  TECH_CHECK
}

// created_at / updated_at은 BaseEntity의 JPA Auditing으로 관리하며 DB 기본값을 두지 않는다.
// 시간 컬럼은 논리 모델에서 정밀도를 생략한다.
// 실제 JPA 생성 DDL은 Hibernate/DB 기본 정밀도를 따른다.

// ======================================
// 1. 사용자 (카카오 로그인)
// ======================================

Table users {
  id bigint [pk, increment]
  kakao_id bigint [not null, unique, note: '카카오 앱 사용자 고유 ID']
  email varchar(254) [note: '선택 정보, 로그인 식별에 사용하지 않음']
  display_name varchar(100)
  profile_image_url varchar(1024)
  last_login_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]

  Note: '카카오 OAuth2 로그인 사용자'
}

// ======================================
// 2. 프로젝트
// ======================================

Table projects {
  id bigint [pk, increment]
  owner_id bigint [not null]
  name varchar(30) [not null]
  client_name varchar(30)
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (owner_id, created_at) [name: 'idx_projects_owner_created']
  }

  Note: '사용자가 생성한 프로젝트'
}

// ======================================
// 3. 제작 기준 버전
// ======================================

Table criteria_versions {
  id bigint [pk, increment]
  project_id bigint [not null]
  version_no int [not null]
  source_text varchar(2000) [note: '사용자가 직접 입력한 제작 원문. 후보 저장 성공 시 같은 트랜잭션에서 NULL로 비우고, 추출 실패 시 수정 및 수동 재시도를 위해 보존한다.']
  status CriteriaVersionStatus [not null, default: 'DRAFT']
  confirmed_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (project_id, version_no) [unique, name: 'uk_criteria_project_version']
  }

  Note: '프로젝트별 제작 기준 버전 및 사용자 확정 상태 관리'
}

// ======================================
// 4. 제작 기준 첨부파일
// ======================================

Table criteria_files {
  id bigint [pk, increment]
  criteria_version_id bigint [not null]
  storage_key varchar(512) [not null]
  original_filename varchar(255) [not null]
  mime_type varchar(120) [not null]
  file_size_bytes bigint [not null]
  text_extraction_status ExtractionStatus [not null, default: 'PENDING']
  extracted_text longtext [note: '작업 중 임시 추출문. 제작 기준 후보 저장 성공 시 같은 트랜잭션에서 NULL로 비운다.']
  delete_requested_at datetime [note: '원본 파일 삭제를 요청한 시각. 삭제 대기 및 재시도 대상 식별에 사용']
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    criteria_version_id [name: 'idx_criteria_files_version']
  }

  Note: '제작 기준 첨부파일 및 파일에서 추출한 텍스트'
}

// ======================================
// 5. AI 제작 기준 추출 실행 기록
// ======================================

Table criteria_extraction_runs {
  id bigint [pk, increment]
  criteria_version_id bigint [not null]
  status AiRunStatus [not null, default: 'PENDING']
  result_json json [note: 'AI가 생성한 원본 추출 결과']
  model_name varchar(100)
  prompt_version varchar(40)
  error_code varchar(60)
  error_message varchar(500)
  created_at datetime [not null]
  updated_at datetime [not null]
  started_at datetime
  llm_called_at datetime [note: '실제 LLM 호출 시각. 호출 전에는 NULL이며 호출 후 실패해도 유지한다.']
  finished_at datetime

  indexes {
    (criteria_version_id, created_at) [name: 'idx_extraction_version_created']
    (status, created_at) [name: 'idx_extraction_status_created']
  }

  Note: 'AI 제작 기준 추출 실행 상태 및 원본 결과 기록'
}

// ======================================
// 6. 개별 제작 기준
// ======================================

Table criteria_items {
  id bigint [pk, increment]
  criteria_version_id bigint [not null]
  item_order int [not null]
  title varchar(200) [not null]
  content text [not null]
  source_ids json [note: '이 카드를 추출한 입력 텍스트·첨부파일의 출처 ID 배열']
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (criteria_version_id, item_order) [unique, name: 'uk_criteria_items_order']
  }

  Note: 'AI가 추출한 후 사용자가 검토, 수정 및 확정하는 개별 제작 기준'
}

// ======================================
// 7. 클라이언트 요청사항
// ======================================

Table client_requests {
  id bigint [pk, increment]
  project_id bigint [not null]
  request_text varchar(2000) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    (project_id, created_at) [name: 'idx_client_requests_project_created']
  }

  Note: '클라이언트의 신규 요청사항'
}

// ======================================
// 8. AI 요청사항 분석 실행 기록
// ======================================

Table request_analysis_runs {
  id bigint [pk, increment]
  client_request_id bigint [not null]
  criteria_version_id bigint [not null]
  status AiRunStatus [not null, default: 'PENDING']
  result_json json [note: 'AI가 생성한 원본 분석 결과']
  model_name varchar(100)
  prompt_version varchar(40)
  error_code varchar(60)
  error_message varchar(500)
  created_at datetime [not null]
  updated_at datetime [not null]
  started_at datetime
  llm_called_at datetime [note: '실제 LLM 호출 시각. 호출 전에는 NULL이며 호출 후 실패해도 유지한다.']
  finished_at datetime

  indexes {
    (client_request_id, created_at) [name: 'idx_request_analysis_request_created']
    criteria_version_id [name: 'idx_request_analysis_criteria']
    (status, created_at) [name: 'idx_request_analysis_status_created']
  }

  Note: '확정된 제작 기준과 클라이언트 요청사항의 AI 비교 분석 실행 기록'
}

// ======================================
// 9. AI 요청사항 분석 세부 항목
// ======================================

Table request_analysis_items {
  id bigint [pk, increment]
  request_analysis_run_id bigint [not null]
  item_order int [not null]
  title text [not null]
  request_excerpt text
  classification RequestAnalysisClassification [not null]
  reason text [not null]
  criteria_evidence text
  suggested_question text [not null]

  indexes {
    (request_analysis_run_id, item_order) [unique, name: 'uk_request_analysis_items_order']
  }

  Note: '개별 요청사항에 대한 AI 판단, 근거 및 확인 질문'
}

// ======================================
// 테이블 관계 (Foreign Keys)
// ======================================

// 사용자 → 프로젝트 (1:N)
Ref: projects.owner_id > users.id [delete: restrict, update: restrict]

// 프로젝트 → 제작 기준 버전 (1:N)
Ref: criteria_versions.project_id > projects.id [delete: restrict, update: restrict]

// 제작 기준 버전 → 첨부파일 (1:N)
Ref: criteria_files.criteria_version_id > criteria_versions.id [delete: restrict, update: restrict]

// 제작 기준 버전 → AI 제작 기준 추출 실행 (1:N)
Ref: criteria_extraction_runs.criteria_version_id > criteria_versions.id [delete: restrict, update: restrict]

// 제작 기준 버전 → 개별 제작 기준 (1:N)
Ref: criteria_items.criteria_version_id > criteria_versions.id [delete: restrict, update: restrict]

// 프로젝트 → 클라이언트 요청사항 (1:N)
Ref: client_requests.project_id > projects.id [delete: restrict, update: restrict]

// 클라이언트 요청사항 → AI 요청사항 분석 실행 (1:N)
Ref: request_analysis_runs.client_request_id > client_requests.id [delete: restrict, update: restrict]

// 제작 기준 버전 → AI 요청사항 분석 실행 (1:N)
Ref: request_analysis_runs.criteria_version_id > criteria_versions.id [delete: restrict, update: restrict]

// AI 요청사항 분석 실행 → 세부 분석 항목 (1:N)
Ref: request_analysis_items.request_analysis_run_id > request_analysis_runs.id [delete: restrict, update: restrict]
